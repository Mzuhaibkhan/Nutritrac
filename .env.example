# ============================================================
# NutriTrack AI — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ── AI Models / LLMs ─────────────────────────────────────────
# You must provide at least one of these keys. The backend will check them in this priority order:
# 1. Google Gemini (native SDK)
# 2. OpenAI GPT (REST API)
# 3. xAI Grok (REST API)
# If none are provided, the site will automatically fall back to an offline/demo heuristic mode!

GEMINI_API_KEY=your_gemini_api_key_here
# Get your key: https://aistudio.google.com/app/apikey

OPENAI_API_KEY=your_openai_api_key_here
# Also accepts: GPT_API_KEY

GROK_API_KEY=your_grok_api_key_here
# Also accepts: XAI_API_KEY

# ── Clerk (Authentication) ───────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
# Found in: Clerk Dashboard > API Keys > Publishable Key

CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
# Found in: Clerk Dashboard > API Keys > Secret Key

CLERK_JWT_KEY=your_clerk_pem_public_key_here
# Optional: Clerk Dashboard > API Keys > JWT verification key (for offline ~0ms token validation)

CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# Optional: JWKS endpoint for dynamic key retrieval

# ── MongoDB ──────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
# For production, use your MongoDB Atlas connection string
MONGODB_DB_NAME=nutritrack
MONGO_MAX_POOL_SIZE=10
# Maximum connection pool size (default: 10, tailored for MongoDB Atlas M0 free tier)
RUN_MIGRATIONS=false
# Set to 'true' only once on cold deploy to ensure indexes are built, then keep false for fast boots

# ── Next.js Public Variables (accessible in browser) ─────────
NEXT_PUBLIC_API_URL=http://localhost:5000
# Local dev: http://localhost:5000
# Docker / Render single-service: (leave empty — same-origin via nginx)

# ── Flask / Backend ──────────────────────────────────────────
FLASK_ENV=development
# Set to 'production' on Render

FLASK_SECRET_KEY=change_this_to_a_long_random_string_in_production
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"

PORT=5000
# Docker: 8080 (default in Dockerfile)
# Render: set automatically by the platform

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:3001
# Render single-service: https://nutritrack.onrender.com

# ── Strava OAuth (optional) ──────────────────────────────────
STRAVA_CLIENT_ID=your_strava_client_id
# Get from Strava Developer portal
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_REDIRECT_URI=http://localhost:5000/api/strava/callback
# Render: https://nutritrack.onrender.com/api/strava/callback

FRONTEND_URL=http://localhost:3000
# Render: https://nutritrack.onrender.com
# Used by Strava OAuth to redirect back to the frontend after auth

# ── App Defaults ─────────────────────────────────────────────
DEFAULT_DAILY_CALORIE_GOAL=2000
DEFAULT_DAILY_BUDGET_USD=30
